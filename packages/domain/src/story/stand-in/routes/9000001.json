    {
      "id": "arrival",
      "steps": [
        {
          "place": "gate"
        },
        {
          "narrate": "An Uma with a seed satchel stops at the Gate and reads the sign twice."
        },
        {
          "say": "9000001",
          "line": "Nine carrot seeds and a field of weeds. This is the place.",
          "emote": "thinking"
        },
        {
          "say": "9000001",
          "line": "I came to grow things, {farmer}. Where do I start?",
          "emote": "happy"
        },
        {
          "choice": [
            {
              "text": "Old Ben’s row. It’s yours to tend.",
              "tone": "warm",
              "friendship": 20,
              "then": [
                {
                  "say": "9000001",
                  "line": "Then I’ll have it green by the weekend.",
                  "emote": "happy"
                }
              ]
            },
            {
              "text": "Can you tell a weed from a carrot?",
              "tone": "playful",
              "friendship": 10,
              "then": [
                {
                  "say": "9000001",
                  "line": "Mostly. Ask me again at harvest.",
                  "emote": "laughing"
                }
              ]
            }
          ]
        },
        {
          "flag": "first-row"
        },
        {
          "thought": "Someone who came for the work itself."
        }
      ]
    },

# Production build config for the SPA: the "Uma Farm web" app's PUBLIC Firebase config, safe in the bundle. Real
# security is the API's Firebase-token guard and its owner allowlist. The auth domain is the farm's own Hosting domain, so
# the sign-in handler is same-origin inside the iOS Home Screen app, as in uma-rpg. One login for all three apps.
VITE_FIREBASE_AUTH_DOMAIN=uma-farm.web.app
VITE_FIREBASE_PROJECT_ID=uma-rpg
VITE_FIREBASE_API_KEY=AIzaSyCysnRIbFgh4ILYIgwjs_rSgyoCnxYbJ2g
VITE_FIREBASE_APP_ID=1:727687479415:web:f5826a5ccf310736684672

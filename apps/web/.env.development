# The dev server plays the romance core on the story pack farm-api serves from content/story-release/
# (`pnpm story:release`, or `--stand-in`), else on the invented stand-in; `VITE_FARM_STORY=stand-in pnpm web` plays
# the stand-in whatever farm-api holds. `VITE_FARM_ROMANCE=0 pnpm web` plays the deployed build on save v3, as
# production does.
VITE_FARM_ROMANCE=1

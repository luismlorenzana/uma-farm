{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "farm-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@farm/api",
        "dev"
      ],
      "port": 8101
    },
    {
      "name": "farm-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@farm/web",
        "dev"
      ],
      "port": 5194
    },
    {
      "name": "farm-story-sandbox",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--experimental-strip-types",
        "--no-warnings",
        "tools/story-sandbox/server.mjs"
      ],
      "port": 4321
    }
  ]
}

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "farm-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@farm/api",
        "dev"
      ],
      "port": 8101
    },
    {
      "name": "farm-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@farm/web",
        "dev"
      ],
      "port": 5194
    },
    {
      "name": "docs-pages",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5199",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/pages"
      ],
      "port": 5199
    }
  ]
}
